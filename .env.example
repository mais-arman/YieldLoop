# Documentation only. This file is NOT loaded automatically.
# Replit supplies DATABASE_URL; do not copy its value into this file.
# Outside Replit, export a real PostgreSQL URL using your secret manager.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=verify-full
DJANGO_ENV=development
# Required in production, at least 50 random characters.
DJANGO_SECRET_KEY=<set-through-secret-manager>
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 1 only behind a trusted proxy that sanitizes forwarded protocol headers.
DJANGO_TRUST_PROXY=0
